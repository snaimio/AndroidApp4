<?xml version="1.0" encoding="utf-8"?>
<!--
    item_episode.xml
    Row layout for a single podcast episode.
    Displays episode title, publication date, and audio/video type badge.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/canvas_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/canvas_border">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Play Circle Icon -->
        <ImageView
            android:id="@+id/imagePlayIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_play"
            app:tint="@color/neon_peach"
            android:contentDescription="Play Episode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Episode Title -->
        <TextView
            android:id="@+id/textViewEpisodeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_headline"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/imagePlayIcon"
            app:layout_constraintEnd_toStartOf="@id/textViewEpisodeType"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ep 128: Understanding Neural Plasticity in Deep Focus" />

        <!-- Media Type Badge (AUDIO / VIDEO) -->
        <TextView
            android:id="@+id/textViewEpisodeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_match_badge"
            android:textColor="@color/mint_green"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="AUDIO" />

        <!-- Release Date -->
        <TextView
            android:id="@+id/textViewEpisodeDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            app:layout_constraintStart_toEndOf="@id/imagePlayIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewEpisodeTitle"
            tools:text="Published Sep 14, 2026" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
