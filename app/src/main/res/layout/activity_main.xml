<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    Creative Retro-Modern Audio UI for SuperPodcast.
    Features an editorial masthead, surprise-vibe dice action,
    glowing search capsule, tactile vibe chips, and magazine-style podcast cards.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_dark"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- Top Editorial Header & Branding -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnDice">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUPER"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/text_headline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="PODCAST"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/neon_peach" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_hero_tag"
                    android:text="EDITION 2026"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/electric_cyan" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sonic mood radar • Tune into your headspace"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Surprise Dice Button (Rolls random vibe) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_dice"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text_headline"
            app:backgroundTint="@color/canvas_surface_elevated"
            app:strokeColor="@color/canvas_border"
            app:strokeWidth="1dp"
            android:contentDescription="Roll surprise mood" />
    </RelativeLayout>

    <!-- Search Capsule with integrated icon and Find button -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_gradient_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_muted"
            android:contentDescription="Search Icon" />

        <EditText
            android:id="@+id/editTextSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Type any vibe (chill, late night, focus)..."
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_headline"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSearch"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="19dp"
            app:backgroundTint="@color/neon_peach"
            android:text="Tune In"
            android:textAllCaps="false"
            android:textColor="@color/text_headline"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Horizontal Tactile Mood Carousel -->
    <HorizontalScrollView
        android:id="@+id/scrollMoodChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMoods"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCozy"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipBackgroundColor="@color/canvas_surface"
                app:chipStrokeColor="@color/canvas_border"
                app:chipStrokeWidth="1.5dp"
                app:chipCornerRadius="14dp"
                android:textColor="@color/text_body"
                android:text="☕ Rainy Loft" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGym"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipBackgroundColor="@color/canvas_surface"
                app:chipStrokeColor="@color/canvas_border"
                app:chipStrokeWidth="1.5dp"
                app:chipCornerRadius="14dp"
                android:textColor="@color/text_body"
                android:text="🔥 High Octane" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCrime"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipBackgroundColor="@color/canvas_surface"
                app:chipStrokeColor="@color/canvas_border"
                app:chipStrokeWidth="1.5dp"
                app:chipCornerRadius="14dp"
                android:textColor="@color/text_body"
                android:text="🕵️ True Noir 2AM" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFocus"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipBackgroundColor="@color/canvas_surface"
                app:chipStrokeColor="@color/canvas_border"
                app:chipStrokeWidth="1.5dp"
                app:chipCornerRadius="14dp"
                android:textColor="@color/text_body"
                android:text="🧠 Mind Lab" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComedy"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipBackgroundColor="@color/canvas_surface"
                app:chipStrokeColor="@color/canvas_border"
                app:chipStrokeWidth="1.5dp"
                app:chipCornerRadius="14dp"
                android:textColor="@color/text_body"
                android:text="🍿 Pop &amp; Banter" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Dynamic Status / Result Indicator Pill -->
    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:textColor="@color/mint_green"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scrollMoodChips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="● 25 PODCASTS TUNED TO RAINY LOFT"
        tools:visibility="visible" />

    <!-- Vinyl Record Empty State Illustration -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintTop_toBottomOf="@id/textViewStatus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageVinyl"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_vinyl"
            android:contentDescription="Vinyl record graphic" />

        <TextView
            android:id="@+id/textViewEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Turn the dial"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_headline" />

        <TextView
            android:id="@+id/textViewEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Pick a mood chip above, roll the dice 🎲,\nor type any vibe to discover matching shows."
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- Modern Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/neon_peach"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/textViewStatus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Podcasts RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/textViewStatus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_podcast" />

</androidx.constraintlayout.widget.ConstraintLayout>
