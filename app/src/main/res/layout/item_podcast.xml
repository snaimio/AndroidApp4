<?xml version="1.0" encoding="utf-8"?>
<!--
    item_podcast.xml
    Sleek modern card for displaying a podcast item with squircle album artwork,
    crisp high-contrast typography, network info, and dynamic mood match badge.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/surface_card_stroke">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Podcast Artwork Thumbnail Card (Rounded Squircle) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardArtwork"
            android:layout_width="76dp"
            android:layout_height="76dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/imageViewArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Podcast Artwork"
                tools:src="@tools:sample/avatars" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Podcast Title / Collection Name -->
        <TextView
            android:id="@+id/textViewPodcastTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_emphasis"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/cardArtwork"
            app:layout_constraintEnd_toStartOf="@id/textViewMoodScore"
            app:layout_constraintTop_toTopOf="@id/cardArtwork"
            tools:text="Huberman Lab Science &amp; Health" />

        <!-- Artist / Creator Name with Podcast Tag -->
        <TextView
            android:id="@+id/textViewArtistName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:textSize="13sp"
            android:textColor="@color/text_medium_emphasis"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/cardArtwork"
            app:layout_constraintEnd_toStartOf="@id/textViewMoodScore"
            app:layout_constraintTop_toBottomOf="@id/textViewPodcastTitle"
            tools:text="Scicomm Media • Dr. Andrew Huberman" />

        <!-- Category & Audio indicator -->
        <TextView
            android:id="@+id/textViewTag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:text="🎙️ Podcast Show"
            android:textSize="11sp"
            android:textColor="@color/text_low_emphasis"
            app:layout_constraintStart_toEndOf="@id/cardArtwork"
            app:layout_constraintTop_toBottomOf="@id/textViewArtistName"
            app:layout_constraintBottom_toBottomOf="@id/cardArtwork" />

        <!-- Dynamic Mood Match Score Badge -->
        <TextView
            android:id="@+id/textViewMoodScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_mood_badge"
            android:textColor="@color/badge_green_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="🔥 96% Vibe" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
