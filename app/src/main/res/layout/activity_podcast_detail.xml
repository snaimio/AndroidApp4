<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_podcast_detail.xml
    Detail screen layout for SuperPodcast.
    Displays album artwork, show title, creator, subscribe/unsubscribe toggle,
    embedded ExoPlayer media view, show notes description, and the scrollable episode list.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_dark"
    android:orientation="vertical">

    <!-- Top Action Bar / Toolbar with Back Navigation and My Subscriptions Shortcut -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/canvas_dark"
        app:title="@string/toolbar_title_detail"
        app:titleTextColor="@color/text_headline"
        app:navigationIconTint="@color/text_headline">

        <!-- My Subscriptions Navigation Shortcut Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubscriptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_bookmark"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/electric_cyan"
            app:backgroundTint="@color/canvas_surface_elevated"
            app:strokeColor="@color/canvas_border"
            app:strokeWidth="1dp"
            android:contentDescription="@string/desc_open_subscriptions" />

    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/canvas_dark"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

        <!-- Top Show Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/canvas_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/canvas_border"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Artwork -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardArtwork"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/canvas_border"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imageViewPodcastArtwork"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/desc_podcast_artwork"
                        tools:src="@tools:sample/avatars" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Podcast Title -->
                <TextView
                    android:id="@+id/textViewPodcastTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_headline"
                    android:maxLines="2"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@id/cardArtwork"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cardArtwork"
                    tools:text="Huberman Lab Podcast" />

                <!-- Artist / Creator Name -->
                <TextView
                    android:id="@+id/textViewPodcastArtist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@id/cardArtwork"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textViewPodcastTitle"
                    tools:text="Scicomm Media • Andrew Huberman" />

                <!-- Subscribe / Unsubscribe Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSubscribe"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="19dp"
                    app:backgroundTint="@color/neon_peach"
                    android:text="@string/btn_subscribe"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_headline"
                    app:layout_constraintStart_toEndOf="@id/cardArtwork"
                    app:layout_constraintTop_toBottomOf="@id/textViewPodcastArtist" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ExoPlayer Media Player View (Audio / Video / HLS) -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="14dp"
            android:background="@color/canvas_surface"
            android:visibility="gone"
            app:use_controller="true"
            app:show_buffering="always"
            app:resize_mode="fit"
            app:layout_constraintTop_toBottomOf="@id/cardHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <!-- Show Notes / Description Section Header -->
        <TextView
            android:id="@+id/labelShowNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/header_show_notes"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/mint_green"
            app:layout_constraintTop_toBottomOf="@id/playerView"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Cleaned Show Notes / Description Body -->
        <TextView
            android:id="@+id/textViewDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_body"
            app:layout_constraintTop_toBottomOf="@id/labelShowNotes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="In this episode, we explore the science of sleep, focus, and dopamine regulation..." />

        <!-- Episodes List Section Header -->
        <TextView
            android:id="@+id/labelEpisodes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/header_available_episodes"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/electric_cyan"
            app:layout_constraintTop_toBottomOf="@id/textViewDescription"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Feed Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBarFeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/neon_peach"
            app:layout_constraintTop_toBottomOf="@id/labelEpisodes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Episodes RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewEpisodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/labelEpisodes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_episode" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
