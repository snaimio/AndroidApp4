<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_subscriptions.xml
    Screen layout displaying all podcasts the user has subscribed to locally in Room database.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_dark"
    android:padding="16dp">

    <!-- Top Action Bar / Toolbar with Back Navigation -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSubscriptions"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/canvas_dark"
        app:title="@string/header_my_subscriptions"
        app:titleTextColor="@color/text_headline"
        app:navigationIconTint="@color/text_headline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State Text View (Shown when no subscriptions exist in Room) -->
    <LinearLayout
        android:id="@+id/layoutEmptySubscriptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbarSubscriptions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/text_dim"
            android:contentDescription="@string/desc_no_subscriptions" />

        <TextView
            android:id="@+id/textViewNoSubscriptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/empty_subscriptions_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/empty_subscriptions_subtitle"
            android:textSize="13sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- Subscriptions List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSubscriptions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarSubscriptions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_subscription" />

</androidx.constraintlayout.widget.ConstraintLayout>
